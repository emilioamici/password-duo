# Credenziali Google (identificativi pubblici, non segreti). In locale copia questo file in .env.local.
# Su GitHub vanno in Settings → Secrets and variables → Actions → Variables.
VITE_GOOGLE_CLIENT_ID=
# Solo per il Google Picker (unirsi alla famiglia di un altro con il permesso ristretto drive.file)
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=

# Facoltativo: URL del Worker per l'accesso persistente, senza "/" finale (vedi worker/README.md)
VITE_AUTH_URL=
